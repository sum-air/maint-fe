# atlas 백엔드 연결 (개발용)
#
# 개발 중에는 vite 프록시(/atlas → VITE_ATLAS_TARGET)를 거치므로 base URL 을 따로 줄
# 필요가 없다. 다른 곳에 붙일 때만 VITE_ATLAS_BASE_URL 을 지정한다.
VITE_ATLAS_TARGET=http://localhost:8080

# 임시. atlas 는 Bearer access token 을 요구하는데 로그인 화면이 아직 없다.
# 로그인이 붙으면 그 흐름이 localStorage 의 atlas.accessToken 을 채우고 이 값은 지운다.
# 값은 절대 커밋하지 않는다 (.env.local 은 gitignore 대상).
VITE_ATLAS_TOKEN=
